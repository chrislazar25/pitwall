#!/opt/homebrew/bin/python3
"""pit: log typed asks to Chris, laps and concepts as append-only events."""

import argparse
import fcntl
import json
import math
import os
import secrets
import shutil
import subprocess
import sys
import tempfile
from contextlib import contextmanager
from datetime import date, datetime, timedelta, timezone
from decimal import Decimal, ROUND_HALF_UP
from statistics import median
from pathlib import Path

ASK_TYPES = ("decide", "review", "unblock", "taste", "context", "teach")
NEEDS_OPTIONS = ("decide", "taste")
REFUSES_DEFAULT = ("context", "unblock", "teach")
WRITES_DECISION = ("decide", "review", "taste", "context")
CONTROL_ACTIONS = ("pause", "cancel", "reprioritize", "revoke")
SCORE_KEYS = ("speed", "ask_quality", "shipping", "ownership")


class BadInput(Exception):
    pass


def data_dir():
    return Path(os.environ.get("PITWALL_HOME") or Path.home() / ".pitwall")


def now():
    return datetime.now(timezone.utc).replace(microsecond=0).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_ts(ts):
    return datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)


def hours_between(start, end):
    return round((parse_ts(end) - parse_ts(start)).total_seconds() / 3600, 2)


def repo_root():
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                       capture_output=True, text=True)
    return Path(r.stdout.strip()) if r.returncode == 0 else None


def current_project():
    root = repo_root()
    return (root.name, root) if root else ("none", None)


def read_events():
    path = data_dir() / "events.jsonl"
    if not path.exists():
        return []
    with path.open() as f:
        return [json.loads(line) for line in f if line.strip()]


def write_atomic(path, text):
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(fd, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def load_json(path, default):
    return json.loads(path.read_text()) if path.exists() else default


# The state is a fold over the event log. Each kind has one reducer.

def fresh_model():
    return {"asks": {}, "laps": {}, "concepts": {}}


def on_ask(m, e):
    m["asks"][e["id"]] = {**e, "open": True, "answers": [], "reopened": False}


def on_answer(m, e):
    ask = m["asks"][e["id"]]
    ask["open"] = False
    ask["answers"].append(e)


def on_reopen(m, e):
    ask = m["asks"][e["id"]]
    ask["open"] = True
    ask["reopened"] = True


def on_lap_start(m, e):
    m["laps"][e["lap"]] = {**e, "shipped_at": None}


def on_lap_ship(m, e):
    m["laps"][e["lap"]]["shipped_at"] = e["ts"]


def on_concept(m, e):
    m["concepts"][(e["project"], e["name"])] = e


REDUCERS = {
    "ask": on_ask,
    "answer": on_answer,
    "reopen": on_reopen,
    "lap_start": on_lap_start,
    "lap_ship": on_lap_ship,
    "concept": on_concept,
    "control": lambda m, e: None,
}


def build_model(events):
    m = fresh_model()
    for e in events:
        REDUCERS[e["kind"]](m, e)
    return m


def build_state(m):
    open_asks = [
        {"id": a["id"], "type": a["type"], "agent": a["agent"], "project": a["project"],
         "headline": a["headline"], "asked_at": a["ts"]}
        for a in m["asks"].values() if a["open"]
    ]
    running = [
        {"lap": l["lap"], "project": l["project"], "title": l["title"], "started_at": l["ts"]}
        for l in m["laps"].values() if l["shipped_at"] is None
    ]
    shipped = sorted((l for l in m["laps"].values() if l["shipped_at"]),
                     key=lambda l: l["shipped_at"])
    lengths = [hours_between(l["ts"], l["shipped_at"]) for l in shipped]
    return {
        "generated_at": now(),
        "open_asks": open_asks,
        "laps": {
            "running": running,
            "last_hours": lengths[-1] if lengths else None,
            "best_hours": min(lengths) if lengths else None,
            "shipped_total": len(shipped),
        },
        "scores": dict.fromkeys(SCORE_KEYS),
        "fuel": None,
        "garage": [],
        "radio": None,
    }


def rebuild_state():
    state = build_state(build_model(read_events()))
    daily = data_dir() / "usage" / "daily.json"
    if daily.exists():
        try:
            rows = validate_usage(read_usage_json(daily))
            state["fuel"] = calculate_fuel(rows, read_ledger(), date.today())
        except BadInput as err:
            print(f"pit: fuel unavailable: {err}", file=sys.stderr)
    for section, reader in (("scores", read_scores), ("garage", read_garage), ("radio", read_radio)):
        try:
            value = reader()
            if section == "scores":
                state[section] = {k: value[-1][k] for k in SCORE_KEYS} if value else dict.fromkeys(SCORE_KEYS)
            else:
                state[section] = value
        except BadInput as err:
            print(f"pit: {section} unavailable: {err}", file=sys.stderr)
    write_atomic(data_dir() / "state.json", json.dumps(state, indent=2) + "\n")
    return state


@contextmanager
def locked(name=".lock"):
    d = data_dir()
    d.mkdir(parents=True, exist_ok=True)
    with (d / name).open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def register_project(name, root):
    if root is None:
        return
    path = data_dir() / "projects.json"
    projects = load_json(path, {})
    if name not in projects:
        projects[name] = str(root)
        write_atomic(path, json.dumps(projects, indent=2) + "\n")


def append(event):
    event = {"ts": now(), **event}
    with (data_dir() / "events.jsonl").open("a") as f:
        f.write(json.dumps(event) + "\n")
    rebuild_state()
    return event


def new_id(prefix):
    return f"{prefix}-{secrets.token_hex(4)}"


# Commands. Each validates against the current model, then appends one event.

def cmd_ask(a, m, project):
    opts = a.option or []
    if a.type in NEEDS_OPTIONS and (len(opts) < 2 or a.default is None):
        raise BadInput(f"{a.type} needs two or more --option and a --default")
    if a.type in REFUSES_DEFAULT and a.default is not None:
        raise BadInput(f"{a.type} takes no --default")
    if a.type == "teach" and not a.concept:
        raise BadInput("teach needs --concept")
    if any(x["open"] and x["agent"] == a.agent and x["project"] == project
           for x in m["asks"].values()):
        print(f"pit: warning: {a.agent} already has an open ask in {project}", file=sys.stderr)
    e = append({"kind": "ask", "id": new_id("a"), "type": a.type, "agent": a.agent,
                "project": project, "headline": a.headline, "reason": a.reason,
                "options": opts, "default": a.default, "artifact": a.artifact,
                "lap": a.lap, "concept": a.concept})
    print(e["id"])


def cmd_answer(a, m, project):
    ask = m["asks"].get(a.id)
    if ask is None:
        raise BadInput(f"unknown ask {a.id}")
    if not ask["open"]:
        raise BadInput(f"ask {a.id} is already answered")
    e = append({"kind": "answer", "id": a.id, "answer": a.answer,
                "took_default": a.took_default, "needed": not a.not_needed})
    if ask["type"] in WRITES_DECISION:
        root = load_json(data_dir() / "projects.json", {}).get(ask["project"])
        if root:
            decisions = Path(root) / ".pit" / "decisions.md"
            decisions.parent.mkdir(exist_ok=True)
            with decisions.open("a") as f:
                f.write(f"- {e['ts'][:10]} [{ask['type']}] {ask['headline']} -> {a.answer}\n")


def cmd_reopen(a, m, project):
    ask = m["asks"].get(a.id)
    if ask is None:
        raise BadInput(f"unknown ask {a.id}")
    if ask["open"]:
        raise BadInput(f"ask {a.id} is not answered")
    append({"kind": "reopen", "id": a.id})


def cmd_control(a, m, project):
    append({"kind": "control", "action": a.action, "agent": a.agent,
            "project": project, "note": a.note})


def cmd_lap_start(a, m, project):
    e = append({"kind": "lap_start", "lap": new_id("l"), "project": project, "title": a.title})
    print(e["lap"])


def cmd_lap_ship(a, m, project):
    lap = m["laps"].get(a.id)
    if lap is None or lap["shipped_at"] is not None:
        raise BadInput(f"no running lap {a.id}")
    append({"kind": "lap_ship", "lap": a.id})


def concept_event(project, name, must_own, status, note=None):
    append({"kind": "concept", "project": project, "name": name,
            "must_own": must_own, "status": status, "note": note})


def existing_concept(m, project, name):
    c = m["concepts"].get((project, name))
    if c is None:
        raise BadInput(f"unknown concept {name} in {project}")
    return c


def cmd_concept_add(a, m, project):
    concept_event(project, a.name, a.must_own, "not_passed")


def cmd_concept_must_own(a, m, project):
    c = existing_concept(m, project, a.name)
    concept_event(project, a.name, True, c["status"])


def cmd_concept_pass(a, m, project):
    c = existing_concept(m, project, a.name)
    concept_event(project, a.name, c["must_own"], "passed")


def cmd_concept_override(a, m, project):
    c = existing_concept(m, project, a.name)
    concept_event(project, a.name, c["must_own"], "passed", a.reason)


def cmd_concept_list(a, m, project):
    for (proj, name), c in m["concepts"].items():
        if proj == project:
            print(f"{name}\tmust-own={'yes' if c['must_own'] else 'no'}\t{c['status']}")


def cmd_open(a, m, project):
    t = parse_ts(now())
    for x in m["asks"].values():
        if x["open"]:
            waiting = int((t - parse_ts(x["ts"])).total_seconds() // 60)
            print(f"{x['id']}\t{x['type']}\t{x['agent']}\t{x['project']}\t{waiting}m\t{x['headline']}")


def cmd_state(a, m, project):
    print(json.dumps(rebuild_state(), indent=2))


USAGE_TOOLS = {"claude": "totalCost", "codex": "costUSD"}
TOKEN_KEYS = ("input_tokens", "output_tokens", "cache_write_tokens", "cache_read_tokens")


def nonnegative(value, label, integer=False):
    if (isinstance(value, bool) or not isinstance(value, (int, float))
            or not math.isfinite(value) or value < 0
            or (integer and not isinstance(value, int))):
        raise BadInput(f"{label} must be a finite nonnegative {'integer' if integer else 'number'}")
    return value


def usage_date(value):
    if not isinstance(value, str):
        raise BadInput("usage date must be YYYY-MM-DD")
    try:
        parsed = date.fromisoformat(value)
    except ValueError:
        raise BadInput("usage date must be YYYY-MM-DD") from None
    if parsed.isoformat() != value:
        raise BadInput("usage date must be YYYY-MM-DD")
    return parsed


def read_usage_json(path):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError) as err:
        raise BadInput(f"cannot read {path.name}: {' '.join(str(err).split())}") from None


def validate_usage(rows):
    if not isinstance(rows, list):
        raise BadInput("daily usage must be a list")
    for row in rows:
        if not isinstance(row, dict):
            raise BadInput("usage row must be an object")
        usage_date(row.get("date"))
        for key in ("tool", "model"):
            if not isinstance(row.get(key), str) or not row[key]:
                raise BadInput(f"usage {key} must be a nonempty string")
        for key in TOKEN_KEYS:
            nonnegative(row.get(key), key, integer=True)
        nonnegative(row.get("api_value_usd"), "api_value_usd")
        if row["cache_write_tokens"] + row["cache_read_tokens"] > row["input_tokens"]:
            raise BadInput("cache tokens exceed input tokens")
    return rows


def read_ledger():
    path = data_dir() / "ledger.json"
    rows = read_usage_json(path) if path.exists() else []
    if not isinstance(rows, list):
        raise BadInput("ledger must be a list")
    for row in rows:
        if not isinstance(row, dict):
            raise BadInput("ledger row must be an object")
        for key in ("provider", "plan", "renews_on"):
            if not isinstance(row.get(key), str) or not row[key].strip():
                raise BadInput(f"ledger {key} must be a nonempty string")
        nonnegative(row.get("usd_per_month"), "ledger usd_per_month")
    return rows


def report_row(tool, day, model, counters, cost):
    if not isinstance(counters, dict):
        raise BadInput(f"{tool} token counters must be an object")
    values = [nonnegative(counters.get(key), f"{tool} {key}", integer=True)
              for key in ("inputTokens", "outputTokens", "cacheCreationTokens", "cacheReadTokens")]
    uncached, out, write, read = values
    return {"date": day, "tool": tool, "model": model,
            "input_tokens": uncached + write + read, "output_tokens": out,
            "cache_write_tokens": write, "cache_read_tokens": read,
            "api_value_usd": nonnegative(cost, f"{tool} cost")}


def map_usage(tool, report):
    if tool not in USAGE_TOOLS:
        raise BadInput(f"unsupported usage tool {tool}")
    if not isinstance(report, dict) or not isinstance(report.get("daily"), list):
        raise BadInput(f"{tool} report needs a daily list")
    rows = []
    for day in report["daily"]:
        if not isinstance(day, dict):
            raise BadInput(f"{tool} daily row must be an object")
        stamp = day.get("date")
        usage_date(stamp)
        aggregate = report_row(tool, stamp, "all", day, day.get(USAGE_TOOLS[tool]))
        total = nonnegative(day.get("totalTokens"), f"{tool} totalTokens", integer=True)
        mapped = []
        if tool == "claude":
            breakdowns = day.get("modelBreakdowns", [])
            if not isinstance(breakdowns, list):
                raise BadInput("claude modelBreakdowns must be a list")
            for model in breakdowns:
                if not isinstance(model, dict):
                    raise BadInput("claude model breakdown must be an object")
                mapped.append(report_row(tool, stamp, model.get("modelName"), model, model.get("cost")))
        else:
            models = day.get("models", {})
            if not isinstance(models, dict):
                raise BadInput("codex models must be an object")
            if any(not isinstance(v, dict) for v in models.values()):
                raise BadInput("codex model counters must be objects")
            if len(models) == 1:
                name, counters = next(iter(models.items()))
                mapped.append(report_row(tool, stamp, name, counters, aggregate["api_value_usd"]))
            elif models and all(isinstance(v, dict) and "costUSD" in v for v in models.values()):
                mapped = [report_row(tool, stamp, name, v, v["costUSD"]) for name, v in models.items()]
        mapped = mapped or [aggregate]
        validate_usage(mapped)
        if (sum(r["input_tokens"] + r["output_tokens"] for r in mapped) != total
                or aggregate["input_tokens"] + aggregate["output_tokens"] != total
                or any(sum(r[k] for r in mapped) != aggregate[k] for k in TOKEN_KEYS)
                or not math.isclose(sum(r["api_value_usd"] for r in mapped),
                                    aggregate["api_value_usd"], rel_tol=1e-9, abs_tol=1e-9)):
            raise BadInput(f"{tool} {stamp} token or cost totals disagree")
        rows.extend(mapped)
    return rows


def calculate_fuel(rows, ledger, today):
    tokens_today = 0
    by_tool = {}
    value = 0
    for row in rows:
        age = (today - date.fromisoformat(row["date"])).days
        tokens = row["input_tokens"] + row["output_tokens"]
        if age == 0:
            tokens_today += tokens
        if 0 <= age < 7:
            by_tool[row["tool"]] = by_tool.get(row["tool"], 0) + tokens
        if 0 <= age < 30:
            value += row["api_value_usd"]
    paid = sum(row["usd_per_month"] for row in ledger)
    return {"tokens_today": tokens_today, "tokens_7d": sum(by_tool.values()),
            "by_tool_7d": [{"tool": tool, "tokens": by_tool[tool]} for tool in sorted(by_tool)],
            "api_value_30d_usd": value, "out_of_pocket_month_usd": paid,
            "value_ratio": value / paid if paid else None}


def cmd_ledger_show(a, m, project):
    rows = read_ledger()
    for row in rows:
        print(f"{row['provider']}\t{row['plan']}\t${row['usd_per_month']:.2f}/mo\t{row['renews_on']}")
    print(f"TOTAL ${sum(row['usd_per_month'] for row in rows):.2f}/mo")


def cmd_usage_pull(a):
    with locked(".usage.lock"):
        with locked():
            config_path = data_dir() / "config.json"
            config = read_usage_json(config_path) if config_path.exists() else {}
            if not isinstance(config, dict):
                raise BadInput("config must be an object")
            npx = config.get("npx") or shutil.which("npx")
            if not isinstance(npx, str) or not Path(npx).is_absolute() or not os.access(npx, os.X_OK):
                raise BadInput("npx must be an absolute executable path in config.json or PATH")
            if config.get("npx") != npx:
                write_atomic(config_path, json.dumps({**config, "npx": npx}, indent=2) + "\n")
            ledger_path = data_dir() / "ledger.json"
            if not ledger_path.exists():
                write_atomic(ledger_path, "[]\n")
            read_ledger()
        raw, rows = {}, []
        for tool in USAGE_TOOLS:
            try:
                result = subprocess.run([npx, "--yes", "ccusage@latest", tool, "daily", "--json"],
                                        capture_output=True, text=True, timeout=120)
            except (OSError, subprocess.TimeoutExpired) as err:
                raise BadInput(f"{tool} usage pull failed: {err}") from None
            if result.returncode:
                detail = " ".join(result.stderr.split())[:300] or f"exit {result.returncode}"
                raise BadInput(f"{tool} usage pull failed: {detail}")
            try:
                report = json.loads(result.stdout)
            except ValueError:
                raise BadInput(f"{tool} usage report is not valid JSON") from None
            mapped = map_usage(tool, report)
            raw[tool] = result.stdout
            rows.extend(mapped)
            if not mapped:
                print(f"pit: {tool}: no data, skipped", file=sys.stderr)
            elif tool == "codex" and any(len(day.get("models", {})) > 1 and
                    not all("costUSD" in v for v in day["models"].values()) for day in report["daily"]):
                print("pit: codex: multiple models without costs, aggregated as all", file=sys.stderr)
        with locked():
            read_ledger()
            usage = data_dir() / "usage"
            usage.mkdir(exist_ok=True)
            for tool, report in raw.items():
                write_atomic(usage / f"raw-{tool}.json", report)
            write_atomic(usage / "daily.json", json.dumps(rows, indent=2) + "\n")
            rebuild_state()


def calculate_scores(events, at):
    past = [e for e in events if parse_ts(e["ts"]) <= at]
    model = build_model(past)
    cutoff = at - timedelta(days=7)
    cohort = []
    for ask in model["asks"].values():
        answers = [e for e in ask["answers"] if cutoff <= parse_ts(e["ts"]) <= at]
        if answers:
            cohort.append((ask, max(reversed(answers), key=lambda e: e["ts"])))
    scores = dict.fromkeys(SCORE_KEYS)
    if cohort:
        waits = [Decimal(str((parse_ts(answer["ts"]) - parse_ts(ask["ts"])).total_seconds())) / 60
                 for ask, answer in cohort]
        scores["speed"] = 100 * (120 - median(waits)) / 115
        scores["ask_quality"] = Decimal(100) * sum(
            answer["needed"] and not ask["reopened"] for ask, answer in cohort) / len(cohort)
    ship_order = {e["lap"]: index for index, e in enumerate(past) if e["kind"] == "lap_ship"}
    shipped = sorted((lap for lap in model["laps"].values() if lap["shipped_at"]),
                     key=lambda lap: (lap["shipped_at"], ship_order[lap["lap"]]))
    duration = lambda lap: Decimal(str((parse_ts(lap["shipped_at"]) - parse_ts(lap["ts"])).total_seconds()))
    current = [duration(lap) for lap in shipped if cutoff <= parse_ts(lap["shipped_at"]) <= at]
    if len(shipped) >= 10 and current:
        baseline, recent = median([duration(lap) for lap in shipped[:10]]), median(current)
        scores["shipping"] = 50 * baseline / recent if recent else (Decimal(100) if baseline > 0 else None)
    concepts = [c for c in model["concepts"].values() if c["must_own"]]
    if concepts:
        scores["ownership"] = Decimal(100) * sum(c["status"] == "passed" for c in concepts) / len(concepts)
    return {key: int(max(Decimal(0), min(Decimal(100), value)).quantize(Decimal(1), rounding=ROUND_HALF_UP))
            if value is not None else None for key, value in scores.items()}


def read_scores(today=None):
    today = today or date.today()
    path = data_dir() / "scores.jsonl"
    if not path.exists():
        return []
    try:
        lines = path.read_text().splitlines()
    except (OSError, UnicodeError) as err:
        raise BadInput(f"cannot read scores.jsonl: {err}") from None
    by_date = {}
    for number, line in enumerate(lines, 1):
        try:
            row = json.loads(line)
            if not isinstance(row, dict) or set(row) != {"date", *SCORE_KEYS}:
                raise BadInput("score row needs date and four scores")
            day = usage_date(row["date"])
            for key in SCORE_KEYS:
                value = row[key]
                if value is not None and (type(value) is not int or not 0 <= value <= 100):
                    raise BadInput("scores must be integers 0 through 100 or null")
            if day <= today:
                by_date[row["date"]] = row
        except (ValueError, BadInput) as err:
            print(f"pit: scores.jsonl line {number} ignored: {err}", file=sys.stderr)
    return [by_date[day] for day in sorted(by_date)]


def read_garage():
    path = data_dir() / "garage.json"
    rows = read_usage_json(path) if path.exists() else []
    if not isinstance(rows, list):
        raise BadInput("garage must be a list")
    for row in rows:
        if (not isinstance(row, dict) or set(row) != {"project", "ci", "tests", "readme", "active", "commits_7d"}
                or not isinstance(row["project"], str) or not row["project"]
                or any(type(row[key]) is not bool for key in ("ci", "tests", "readme", "active"))):
            raise BadInput("invalid garage row")
        nonnegative(row["commits_7d"], "commits_7d", integer=True)
    return rows


def parse_coach_note(text, insufficient=False):
    text = text.replace("\r\n", "\n")
    body = text[:-1] if text.endswith("\n") else text
    lines = body.split("\n")
    if (len(lines) != 2 or any(c in body for c in ("\r", "\u2028", "\u2029")) or "```" in body
            or not lines[0].startswith("Observation: ") or not lines[1].startswith("Tweak: ")):
        raise BadInput("coach reply must be exactly Observation: and Tweak: lines")
    observation, tweak = lines[0][13:].strip(), lines[1][7:].strip()
    if not observation or not tweak:
        raise BadInput("coach observation and tweak must be nonempty")
    if insufficient and "not enough data yet" not in observation.lower():
        raise BadInput("coach observation must say not enough data yet with under seven days of events")
    return {"observation": observation, "tweak": tweak}


def read_radio(today=None):
    today = today or date.today()
    folder = data_dir() / "coach"
    if not folder.exists():
        return None
    try:
        paths = sorted(folder.glob("*.md"), reverse=True)
    except OSError as err:
        raise BadInput(f"cannot read coach notes: {err}") from None
    for path in paths:
        try:
            day = usage_date(path.stem)
        except BadInput:
            continue
        if day > today:
            continue
        try:
            return {"date": day.isoformat(), **parse_coach_note(path.read_text())}
        except (BadInput, OSError, UnicodeError) as err:
            print(f"pit: coach note {path.name} ignored: {err}", file=sys.stderr)
    return None


def cmd_score(a, m, project):
    at = parse_ts(now())
